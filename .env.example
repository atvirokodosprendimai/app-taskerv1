# Copy to .env and adjust; docker compose reads .env from this directory.

# The port tasker listens on, inside the container and on the host.
TASKER_PORT=1222

# Set to true only when tasker is reached over HTTPS, behind a TLS proxy. Over
# plain HTTP the browser never sends a Secure cookie back, so every page after
# signing in would be signed out again.
TASKER_SECURE_COOKIES=false
