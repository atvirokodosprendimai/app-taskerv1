package view

import (
	"strconv"

	"github.com/atvirokodosprendimai/app-taskerv1/internal/tracking"
)

// DashboardPage is the timers screen: what is running, and a start box per
// company.
//
// It opens the page's ONE stream (data-init on .dash). Both fragments the stream
// sends — the running list every second, the company list on a change — have a
// wrapper that is always rendered, because a patch can only replace an element
// already in the document.
//
// The stream is opened with retry 'always'. datastar's default retries only a
// network error (read from the 1.0.3 bundle), so a stream the SERVER ends — a
// restart, a proxy closing an idle connection — would leave the timers frozen
// with nothing on the page to say so. It sends no signals: the stream reads
// none, and half-typed task names have no business in a URL.
templ DashboardPage(d Dashboard) {
	@Shell(d.Page) {
		<div class="page-head">
			<div>
				<h1>Timers</h1>
				<p>Start as many as you need — they run side by side.</p>
			</div>
		</div>
		@Flash("")
		<div class="dash" data-init="@get('/stream', {retry: 'always', filterSignals: {include: /^$/}})">
			<section class="panel running-panel" aria-labelledby="running-heading">
				<div class="panel-head">
					<h2 id="running-heading">Running now</h2>
				</div>
				@RunningTimers(d.Timers)
			</section>
			<section class="panel" aria-labelledby="companies-heading">
				<div class="panel-head">
					<h2 id="companies-heading">Companies</h2>
				</div>
				<div class="add-company">
					<label class="sr-only" for="new-company">New company name</label>
					<input
						id="new-company"
						class="input"
						type="text"
						maxlength={ strconv.Itoa(tracking.MaxCompanyName) }
						placeholder="Add a company…"
						autocomplete="off"
						data-bind="newCompany"
						data-on:keydown={ enterSubmits(addCompanyAction) }
					/>
					<button
						type="button"
						class="btn btn-primary"
						data-on:click={ addCompanyAction }
						data-indicator="_addingCompany"
						data-attr:disabled="$_addingCompany"
					>Add company</button>
				</div>
				@CompanyList(d.Companies)
			</section>
		</div>
		@NoDialog()
	}
}

// RunningTimers is the running-timers list. The stream re-sends it every second
// while anything runs, with only Timers.Now changed.
templ RunningTimers(t Timers) {
	<div id="running-timers">
		if len(t.Entries) == 0 {
			<div class="empty">
				<p class="empty-title">Nothing running</p>
				<p>Type what you are working on under a company and press Start.</p>
			</div>
		} else {
			<p class="running-summary">
				<strong>{ runningLabel(len(t.Entries)) }</strong>
				· <span class="mono">{ t.Combined() }</span> combined
			</p>
			<ul class="timer-list" role="list">
				for _, e := range t.Entries {
					<li class="timer" id={ timerDOMID(e.ID) }>
						<span class="pulse" aria-hidden="true"></span>
						<div class="timer-main">
							<p class="timer-company">{ e.CompanyName }</p>
							<p class="timer-task">
								if e.Task == "" {
									<span class="muted">No description</span>
								} else {
									{ e.Task }
								}
								<button
									type="button"
									id={ EntryOpenerID(e.ID) }
									class="btn btn-quiet btn-small btn-inline"
									aria-haspopup="dialog"
									data-on:click={ openEntryAction(e.ID, false) }
								>
									Edit<span class="sr-only">{ entryEditLabel(e.CompanyName, e.Task) }</span>
								</button>
							</p>
							<p class="timer-started">{ t.Started(e) }</p>
						</div>
						<p class="timer-elapsed mono">{ t.Elapsed(e) }</p>
						<button
							type="button"
							class="btn btn-stop"
							data-on:click={ stopAction(e.ID) }
							data-indicator={ busySignal("stopping", e.ID) }
							data-attr:disabled={ "$" + busySignal("stopping", e.ID) }
						>
							Stop<span class="sr-only">{ " " + stopLabel(e) }</span>
						</button>
					</li>
				}
			</ul>
		}
	</div>
}

// CompanyList is the grid of company cards.
templ CompanyList(companies []tracking.Company) {
	<div id="company-list" class="company-grid">
		if len(companies) == 0 {
			<div class="empty">
				<p class="empty-title">No companies yet</p>
				<p>Add the first company you work for, then start a timer on it.</p>
			</div>
		}
		for _, c := range companies {
			@companyCard(c)
		}
	</div>
}

templ companyCard(c tracking.Company) {
	<article class={ "company", templ.KV("is-running", c.Running > 0) } id={ companyDOMID(c.ID) }>
		<div class="company-head">
			<h3>{ c.Name }</h3>
			<div class="company-tools">
				if c.Running > 0 {
					<span class="badge">{ runningLabel(c.Running) }</span>
				}
				<button
					type="button"
					id={ LogOpenerID(c.ID) }
					class="btn btn-quiet btn-small"
					aria-haspopup="dialog"
					data-on:click={ openLogAction(c.ID) }
				>
					Log time<span class="sr-only">{ " for " + c.Name }</span>
				</button>
			</div>
		</div>
		<div class="start-row">
			<label class="sr-only" for={ taskInputID(c.ID) }>{ "What are you working on for " + c.Name + "?" }</label>
			<input
				id={ taskInputID(c.ID) }
				class="input"
				type="text"
				maxlength={ strconv.Itoa(tracking.MaxTask) }
				placeholder="Task name (optional)"
				autocomplete="off"
				data-bind={ TaskSignal(c.ID) }
				data-on:keydown={ enterSubmits(startAction(c.ID)) }
			/>
			<button
				type="button"
				class="btn btn-start"
				data-on:click={ startAction(c.ID) }
				data-indicator={ busySignal("starting", c.ID) }
				data-attr:disabled={ "$" + busySignal("starting", c.ID) }
			>
				Start<span class="sr-only">{ " a timer for " + c.Name }</span>
			</button>
		</div>
	</article>
}
